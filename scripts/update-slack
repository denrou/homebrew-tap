#!/usr/bin/env bash
# Rewrites Formula/slack.rb for one release of denrou/slack, from the
# checksums.txt its Release workflow publishes next to the archives.
#
#   scripts/update-slack          the latest release
#   scripts/update-slack 0.8.0    that release
set -euo pipefail
cd "$(dirname "$0")/.."

repo="denrou/slack"
version="${1:-}"
if [ -z "$version" ]; then
  # The "latest" page redirects to the tag, which saves a token and gh.
  latest="$(curl -fsSL -o /dev/null -w '%{url_effective}' "https://github.com/$repo/releases/latest")"
  version="${latest##*/tag/v}"
fi
base="https://github.com/$repo/releases/download/v$version"
checksums="$(curl -fsSL "$base/checksums.txt")"

sha() {
  local line
  line="$(grep -F " slack-v$version-$1.tar.gz" <<<"$checksums")" || {
    echo "v$version has no checksum for $1" >&2
    exit 1
  }
  echo "${line%% *}"
}
mac_sha="$(sha aarch64-apple-darwin)"
linux_sha="$(sha x86_64-unknown-linux-gnu)"

cat >Formula/slack.rb <<RUBY
class Slack < Formula
  desc "Unread Slack messages in the terminal, with a screen to read and reply"
  homepage "https://github.com/denrou/slack"
  license "MIT"

  on_macos do
    on_arm do
      url "$base/slack-v$version-aarch64-apple-darwin.tar.gz"
      sha256 "$mac_sha"
    end
  end

  on_linux do
    on_intel do
      url "$base/slack-v$version-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "$linux_sha"
    end
  end

  def install
    bin.install "slack"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/slack --version")
  end
end
RUBY
echo "Formula/slack.rb now describes v$version"
