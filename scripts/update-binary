#!/usr/bin/env bash
# Rewrites Formula/<name>.rb for one release of denrou/<name>, from the
# checksums.txt its Release workflow publishes next to the archives
# (<name>-v<version>-<target>.tar.gz, macOS arm64 and Linux x86_64).
#
#   scripts/update-binary slack           the latest release
#   scripts/update-binary gh-prs 0.19.0   that release
set -euo pipefail
cd "$(dirname "$0")/.."

name="${1:?usage: scripts/update-binary <formula> [version]}"
case "$name" in
  slack)
    class="Slack"
    desc="Unread Slack messages in the terminal, with a screen to read and reply"
    binaries=(slack)
    ;;
  gh-prs)
    class="GhPrs"
    desc="List the GitHub pull requests and issues that need your attention"
    # One release of the denrou/gh-prs workspace ships both tools.
    binaries=(gh-prs gh-issues)
    ;;
  *)
    echo "$name does not ship release binaries" >&2
    exit 1
    ;;
esac

repo="denrou/$name"
version="${2:-}"
if [ -z "$version" ]; then
  # The "latest" page redirects to the tag, which saves a token and gh.
  latest="$(curl -fsSL -o /dev/null -w '%{url_effective}' "https://github.com/$repo/releases/latest")"
  version="${latest##*/tag/v}"
fi
base="https://github.com/$repo/releases/download/v$version"
checksums="$(curl -fsSL "$base/checksums.txt")"

sha() {
  local line
  line="$(grep -F " $name-v$version-$1.tar.gz" <<<"$checksums")" || {
    echo "v$version has no checksum for $1" >&2
    exit 1
  }
  echo "${line%% *}"
}
mac_sha="$(sha aarch64-apple-darwin)"
linux_sha="$(sha x86_64-unknown-linux-gnu)"

# "a", "b" for bin.install, and one version check per binary.
installed="$(printf '"%s", ' "${binaries[@]}")"
installed="${installed%, }"
checks="$(printf '    assert_match version.to_s, shell_output("#{bin}/%s --version")\n' "${binaries[@]}")"

cat >"Formula/$name.rb" <<RUBY
class $class < Formula
  desc "$desc"
  homepage "https://github.com/$repo"
  license "MIT"

  on_macos do
    on_arm do
      url "$base/$name-v$version-aarch64-apple-darwin.tar.gz"
      sha256 "$mac_sha"
    end
  end

  on_linux do
    on_intel do
      url "$base/$name-v$version-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "$linux_sha"
    end
  end

  def install
    bin.install $installed
  end

  test do
$checks
  end
end
RUBY
echo "Formula/$name.rb now describes v$version"
